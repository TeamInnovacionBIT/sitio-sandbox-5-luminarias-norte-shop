# Luminarias Norte — configuración de Apache / LiteSpeed (Hostinger)

Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# Tipos de contenido
AddType text/markdown .md
AddType text/javascript .js .mjs
AddType text/plain .txt
AddType application/xml .xml
AddCharset UTF-8 .md .txt .html .css .js .mjs .xml

<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>
  <FilesMatch "^(llms|robots)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Redirecciones: http -> https y www -> sin www (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://luminariasnorte.shop%{REQUEST_URI} [L,R=301]

  # Defensa adicional: estas carpetas no se publican, pero si se subieran por error no se sirven
  RewriteRule ^(interno|servicio-react)(/|$) - [R=404,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown text/javascript application/javascript application/xml image/svg+xml
</IfModule>

# Caché: HTML y Markdown siempre revalidados; recursos estáticos con caché moderada.
# La caché de larga duración de /diseno-de-iluminacion/assets/ está en el .htaccess de esa carpeta
# (lo copia el build de Vite desde servicio-react/public/assets/.htaccess).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/markdown "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
